# Copy to .env; no secrets are required to run the demo.
# The PII salt feeds the salted SHA-256 hash of contact values; set a
# long random value per environment in production (rotating it changes
# all stored hashes, so treat it as a deployment-time constant).
APERS_PII_SALT=dev-only-pii-salt
APERS_HOST=0.0.0.0
APERS_PORT=8000
